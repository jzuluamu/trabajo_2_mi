# ServicioCerca — variables de entorno (copiar a .env con `make env`).
# Los valores CHANGE_ME_* son rechazados por los servicios al arrancar: `make env` los reemplaza
# por secretos aleatorios. Documentación: docs/10-guia-prueba-manual.md

# --- Base de datos (solo la usa network-service) ---
POSTGRES_USER=serviciocerca
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=serviciocerca

# --- API keys por rol (mínimo 16 caracteres, distintas entre sí) ---
# Coordinador: registra bases, técnicos, zonas y conexiones (lectura + escritura).
COORDINATOR_API_KEY=CHANGE_ME_coordinator_key
# Operador: consulta cobertura y alternativa de atención (solo lectura).
OPERATOR_API_KEY=CHANGE_ME_operator_key
# Interna: routing-service -> network-service. No se usa en la consola.
INTERNAL_API_KEY=CHANGE_ME_internal_key

# --- Puertos publicados en 127.0.0.1 (cambiar solo si hay conflicto local) ---
NETWORK_PORT=8001
ROUTING_PORT=8002
CONSOLE_PORT=8501

# --- Observabilidad ---
LOG_LEVEL=INFO
